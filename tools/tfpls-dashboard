#!/usr/bin/env bash
# tfpls-dashboard <owner/repo> [out-dir]  Build the dashboard from a repository's tfpls-data branch and open it.
# Works for private repositories (uses your `gh` login), needs no Pages and no CI run.
# Runs `tfpls dashboard open`: the tfpls binary on the PATH, else built from this checkout with Go.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
[ $# -ge 1 ] || { echo "usage: tfpls-dashboard <owner/repo> [out-dir]" >&2; exit 2; }
if command -v tfpls >/dev/null 2>&1; then exec tfpls dashboard open "$@"; fi
cd "$here" && exec go run ./cmd/tfpls dashboard open "$@"
