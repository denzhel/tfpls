#!/usr/bin/env bash
# tfpls-dashboard <owner/repo> [out-dir]  Build the dashboard from a repository's tfpls-data branch and open it.
# Works for private repositories (uses your `gh` login), needs no Pages and no CI run.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
repo=${1:?usage: tfpls-dashboard <owner/repo> [out-dir]}; out=${2:-$(mktemp -d)}
d=$(mktemp -d); trap 'rm -rf "$d"' EXIT
token=$(gh auth token)
git clone --quiet --depth 1 --branch tfpls-data "https://x-access-token:${token}@github.com/${repo}.git" "$d" 2>/dev/null \
  || echo "no tfpls-data branch in $repo yet (enable audit: true and run a drift check); building an empty page" >&2
REPO="$repo" "$here/actions/dashboard/build.sh" "$d" "$out"
echo "$out/index.html"
if command -v open >/dev/null 2>&1; then open "$out/index.html"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$out/index.html"; fi
