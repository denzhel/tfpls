joke() {
  local n=${#jokes_list[@]} i
  $jokes || return 0
  if [[ ${TFPLS_JOKE_SEED:-} =~ ^[0-9]{1,9}$ ]]; then i=$((10#$TFPLS_JOKE_SEED % n)); else i=$((RANDOM % n)); fi
  printf '\n  %s💬 %s%s\n\n' "$D" "${jokes_list[$i]}" "$R"
}

main() {
  parse_args "$@"
  [ -d "$dir" ] || { echo "no such directory: $dir" >&2; exit 1; }
  cd "$dir" || exit 1
  setup_output
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/tfpls-onboard.XXXXXX") || die "cannot create a temporary directory"
  trap 'rm -rf "$tmpd"' EXIT
  # questions only with a person at a terminal: stdout is a terminal and /dev/tty can be opened (also under curl | bash)
  interactive=false
  if ! $yes && ! $dry; then
    if [ -n "${TFPLS_ONBOARD_TTY:-}" ]; then { exec 3<"$TFPLS_ONBOARD_TTY"; } 2>/dev/null && interactive=true
    elif [ -t 1 ] && { exec 3</dev/tty; } 2>/dev/null; then interactive=true; fi
  fi
  nwarn=0; done_items=(); left_items=(); ver_deep=""
  docs="https://github.com/$slug/blob/$ref/docs"
  logo
  scan_git
  scan_layout
  scan_tf
  scan_github_files
  understand
  report
  online_lookup
  in_short
  files_step
  online_settings
  checklist
  joke
}

main "$@"
