#!/usr/bin/env bash
# tfpls onboarding: looks at the repository, says what it understood and what it would change, asks (Enter takes the
# default), writes the caller workflow (and .tfpls.yml only when the layout needs one) and ends with a checklist.
# Safe to run again: an up-to-date file is left alone, a differing one is shown as a diff and replaced only on a yes or
# with --force, .tfpls.yml is never overwritten, no workflow is ever deleted. Offline unless you say yes to the GitHub step.
#   tools/onboard [--yes] [--dry-run] [--force] [--no-jokes] [--ref v0] [--slug owner/tfpls] [--runs-on ubuntu-latest] [dir]
#   curl -fsSL https://raw.githubusercontent.com/denzhel/tfpls/v0/tools/onboard | bash        (answers come from /dev/tty)
# NO_COLOR=1: no colours; FORCE_COLOR=1: colours without a terminal; TFPLS_JOKE_SEED=<n>: that joke.
# Tests only: TFPLS_ONBOARD_TTY=<file> reads the answers from that file instead of the terminal (the questions are shown).
# Everything is in functions and `main` runs on the last line, so a download cut short under `curl | bash` runs nothing.
# Bash 3.2 (macOS): the rules of tests/bash32.test.sh, empty arrays only as ${a[@]+"${a[@]}"}, no case inside $(...).
set -uo pipefail

TOFU_DEFAULT=1.13.1   # the default of actions/setup (tests/onboard.test.sh keeps the two equal)

usage() { cat <<'USAGE'
tfpls onboarding: looks at your repository, says what it understood, asks (Enter takes the default), then writes
.github/workflows/tofu.yml (and .tfpls.yml only when your layout needs one) and ends with a checklist of what is left.
  tools/onboard [options] [dir]
  curl -fsSL https://raw.githubusercontent.com/denzhel/tfpls/v0/tools/onboard | bash -s -- [options]
Options:
  --yes              no questions: take every default (a differing workflow is kept, nothing goes online)
  --dry-run          show what would change (as diffs) and write nothing
  --force            replace a differing caller workflow without asking (.tfpls.yml is never overwritten)
  --no-jokes         no joke at the end
  --runs-on LABEL    runner label or JSON array of labels (default ubuntu-latest; ubuntu-slim is cheaper but cuts
                     every job after 15 minutes: only for workspaces that apply quickly)
  --ref REF          the tfpls version the caller uses (default v0)
  --slug OWNER/REPO  where tfpls lives (default denzhel/tfpls)
Safe to run again: a second run changes nothing. Offline, except an optional GitHub step (gh) that you say yes to.
NO_COLOR=1 switches the colours off.
USAGE
}

parse_args() {
  yes=false; dry=false; force=false; jokes=true; ref=v0; slug=denzhel/tfpls; runs_on=ubuntu-latest
  while [ $# -gt 0 ]; do
    case $1 in
      --yes) yes=true; shift ;;
      --dry-run) dry=true; shift ;;
      --force) force=true; shift ;;
      --no-jokes) jokes=false; shift ;;
      --ref|--slug|--runs-on)
        [ $# -ge 2 ] && [ -n "$2" ] || { echo "$1 needs a value" >&2; usage >&2; exit 2; }
        case $1 in --ref) ref=$2 ;; --slug) slug=$2 ;; --runs-on) runs_on=$2 ;; esac
        shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
      *) break ;;
    esac
  done
  [ $# -le 1 ] || { echo "one directory at most" >&2; exit 2; }
  dir=${1:-.}
  # these end up in YAML: strict patterns only
  [[ $ref =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "--ref: letters, digits and . _ / - only" >&2; exit 2; }
  [[ $slug =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || { echo "--slug: OWNER/REPO" >&2; exit 2; }
  [[ $runs_on =~ ^[A-Za-z0-9._-]+$ || $runs_on =~ ^\[[[:space:]]*\"[A-Za-z0-9._-]+\"([[:space:]]*,[[:space:]]*\"[A-Za-z0-9._-]+\")*[[:space:]]*\]$ ]] \
    || { echo "--runs-on: a runner label, or a JSON array of labels such as '[\"self-hosted\",\"linux\"]'" >&2; exit 2; }
}

# ---- output ------------------------------------------------------------------------------------------------------------
setup_output() {
  if [ -z "${NO_COLOR:-}" ] && { [ "${FORCE_COLOR:-}" = 1 ] || { [ -t 1 ] && [ "${TERM:-}" != dumb ]; }; }; then
    B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; RD=$'\033[31m'; C=$'\033[36m'; M=$'\033[35m'; R=$'\033[0m'
  else B=""; D=""; G=""; Y=""; RD=""; C=""; M=""; R=""; fi
  spin=false   # a spinner only on a real terminal, never in a log
  if [ -t 1 ] && [ "${TERM:-}" != dumb ]; then spin=true; fi
}
ok()      { printf '  %s✔%s %s\n' "$G" "$R" "$*"; }
warn()    { printf '  %s!%s %s\n' "$Y" "$R" "$*"; nwarn=$((nwarn + 1)); }
note()    { printf '  %s•%s %s\n' "$C" "$R" "$*"; }
section() { printf '\n%s%s%s\n' "$B" "$*" "$R"; }
row()     { printf '  %s%-11s%s %s\n' "$D" "$1" "$R" "$2"; }
die()     { printf '%s✘ %s%s\n' "$RD" "$*" "$R" >&2; exit 1; }
join()    { local sep=$1 out="" x; shift; for x in "$@"; do out="${out:+$out$sep}$x"; done; printf '%s' "$out"; }
safe()    { case $1 in ''|*[!A-Za-z0-9._-]*|.*) return 1;; esac; return 0; }
valid_arn() { [[ $1 =~ ^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; }
done_()   { done_items+=("$1"); }
left()    { left_items+=("$1"); }

logo() {
  printf '\n%s     ________%s\n' "$Y" "$R"
  printf '%s    /_______/|%s   %s%stfpls%s onboarding\n' "$Y" "$R" "$B" "$M" "$R"
  printf '%s    | o   o ||%s   OpenTofu on GitHub Actions\n' "$Y" "$R"
  printf '%s    |  \\_/  ||%s   %splan on pull requests, apply by comment, drift checks%s\n' "$Y" "$R" "$D" "$R"
  printf '%s    |_______|/%s\n' "$Y" "$R"
}

# ---- questions (from /dev/tty, so they work under curl | bash; never without a terminal) --------------------------------
read_reply() { # one line from the keyboard (fd 3) into $reply; 1 at the end of the input
  reply=""
  if ! IFS= read -r reply <&3 && [ -z "$reply" ]; then printf '\n'; return 1; fi
  reply=${reply%$'\r'}
  reply=$(printf '%s' "$reply" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [ -t 3 ] || printf '%s\n' "$reply"   # answers that do not come from a terminal are echoed: the transcript reads well
  return 0
}
ask() { # ask <question> <y|n>: 0 = yes. Without a terminal, with --yes or --dry-run nothing is asked: the default counts.
  local q=$1 def=$2 hint="[y/N]" tries=0
  [ "$def" = y ] && hint="[Y/n]"
  if ! $interactive; then [ "$def" = y ]; return; fi
  while [ "$tries" -lt 3 ]; do
    printf '  %s?%s %s %s%s%s ' "$M" "$R" "$q" "$D" "$hint" "$R"
    read_reply || { [ "$def" = y ]; return; }
    case $reply in
      '') [ "$def" = y ]; return ;;
      [Yy]|[Yy][Ee][Ss]) return 0 ;;
      [Nn]|[Nn][Oo]) return 1 ;;
    esac
    tries=$((tries + 1)); note "please answer y or n (Enter takes the default)"
  done
  [ "$def" = y ]
}
ask_text() { # ask_text <question> <default> <check>: the answer in $answer (the default without a terminal or on Enter)
  local q=$1 def=$2 check=$3 tries=0 shown
  answer=$def
  $interactive || return 0
  shown="[$def]"; [ -n "$def" ] || shown="(Enter skips)"
  while [ "$tries" -lt 3 ]; do
    printf '  %s?%s %s %s%s%s ' "$M" "$R" "$q" "$D" "$shown" "$R"
    read_reply || return 0
    [ -n "$reply" ] || return 0
    if "$check" "$reply"; then answer=$reply; return 0; fi
    tries=$((tries + 1)); note "that does not look right, try again (Enter takes the default)"
  done
  return 0
}
frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
quietly() { # quietly <label> <command...>: no input, output in $tmpd/out and $tmpd/err; a spinner turns on a terminal
  local label=$1 pid i=0 rc; shift
  if $spin; then
    "$@" </dev/null >"$tmpd/out" 2>"$tmpd/err" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r  %s%s%s %s' "$C" "${frames[$((i % 10))]}" "$R" "$label"; i=$((i + 1)); sleep 0.1
    done
    wait "$pid"; rc=$?
    printf '\r\033[K'
  else
    "$@" </dev/null >"$tmpd/out" 2>"$tmpd/err"; rc=$?
  fi
  return "$rc"
}

# ---- looking around ----------------------------------------------------------------------------------------------------
scan_git() {
  local cand rem top
  in_git=false; branch=""; branch_src=""; owner=""; repo=""; top_ok=true
  if git rev-parse --git-dir </dev/null >/dev/null 2>&1; then
    in_git=true
    branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD </dev/null 2>/dev/null | sed 's|^origin/||')
    [ -n "$branch" ] && branch_src="origin/HEAD"
    # no origin/HEAD (a fresh clone of an empty repository, a repository created here): the usual names first, because
    # onboarding often runs on a feature branch and the push trigger must name the DEFAULT branch
    if [ -z "$branch" ]; then
      for cand in main master; do
        if git show-ref --quiet "refs/remotes/origin/$cand" </dev/null || git show-ref --quiet "refs/heads/$cand" </dev/null; then
          branch=$cand; branch_src="guessed"; break
        fi
      done
    fi
    if [ -z "$branch" ]; then branch=$(git symbolic-ref --quiet --short HEAD </dev/null 2>/dev/null); branch_src="the current branch"; fi
    top=$(git rev-parse --show-toplevel </dev/null 2>/dev/null)
    if [ -n "$top" ] && [ "$top" != "$(pwd -P)" ]; then top_ok=false; fi
    # the repository on GitHub (for the trust policy), read from the remote with a strict pattern; never echoed otherwise
    rem=$(git remote get-url origin </dev/null 2>/dev/null)
    if [[ $rem =~ ^(https://([^@/]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)([A-Za-z0-9-]+)/([A-Za-z0-9._-]+)$ ]]; then
      owner=${BASH_REMATCH[3]}; repo=${BASH_REMATCH[4]}; repo=${repo%.git}
      safe "$repo" || { owner=""; repo=""; }
    fi
  fi
  case $branch in ''|*[!A-Za-z0-9._/-]*) branch=main; branch_src="assumed";; esac
}

scan_layout() {
  local d n f cand
  found=(); skipped=(); varfiles=(); vardir=""; envdirs=(); layout=none; root_stack=false; root_tf=false; root_backend=false
  if ls ./*.tf >/dev/null 2>&1; then root_tf=true; fi
  if $root_tf && grep -qsE '^[[:space:]]*backend[[:space:]]+"' ./*.tf; then root_backend=true; fi
  # 1: one folder per workspace under workspaces/ (the default, no config needed)
  if [ -d workspaces ]; then
    for d in workspaces/*/; do
      [ -d "$d" ] || continue; n=$(basename "$d")
      if safe "$n"; then found+=("$n"); else skipped+=("$n"); fi
    done
  fi
  # 2: one root module and one var file per workspace
  if [ "${#found[@]}" -eq 0 ] && $root_tf; then
    for cand in vars env envs environments tfvars .; do
      [ -d "$cand" ] || continue
      for f in "$cand"/*.tfvars; do
        [ -f "$f" ] || continue; n=$(basename "$f" .tfvars)
        [ "$n" = terraform ] && continue; case $n in *.auto) continue;; esac
        if safe "$n"; then varfiles+=("$n"); fi
      done
      if [ "${#varfiles[@]}" -gt 0 ]; then vardir=$cand; break; fi
    done
  fi
  # 3: separate root modules (a backend block in each directory), the tofu workspace is `default`
  if [ "${#found[@]}" -eq 0 ] && [ "${#varfiles[@]}" -eq 0 ]; then
    while IFS= read -r f; do
      d=$(dirname "$f"); d=${d#./}
      case $d in .|workspaces/*|modules/*|*/modules/*|.terraform/*|*/.terraform/*) continue;; esac
      case " ${envdirs[*]-} " in *" $d "*) continue;; esac
      if safe "${d//\//-}"; then envdirs+=("$d"); fi
    done < <(find . -mindepth 2 -maxdepth 4 -name '*.tf' -not -path './.git/*' -not -path '*/.terraform/*' -print0 2>/dev/null \
              | xargs -0 grep -lE '^[[:space:]]*backend[[:space:]]+"' 2>/dev/null | sort)
  fi
  # 4: one root stack: the root module in the repository root with a single state (the tofu workspace `default`)
  if [ "${#found[@]}" -gt 0 ]; then layout=folders
  elif [ "${#varfiles[@]}" -gt 0 ]; then layout=varfile
  elif [ "${#envdirs[@]}" -gt 0 ]; then layout=envs; $root_backend && root_stack=true
  elif $root_tf; then layout=root; root_stack=true; fi
  stack_dirs=()
  case $layout in
    folders|varfile|root) stack_dirs=(.) ;;
    envs) $root_stack && stack_dirs=(.); stack_dirs+=("${envdirs[@]}") ;;
  esac
  # the stack of a root module is named after the repository (the remote, else this directory)
  stack_name=${repo:-$(basename "$(pwd -P)")}
  stack_name=${stack_name//[!A-Za-z0-9._-]/-}
  while [ "${stack_name#.}" != "$stack_name" ]; do stack_name=${stack_name#.}; done
  safe "$stack_name" || stack_name=infra
}

blocks() { # blocks <awk pattern> <files...>: the lines of every block whose header matches (header to closing brace)
  local pat=$1; shift
  awk -v pat="$pat" 'FNR == 1 { inb = 0 }
    !inb && $0 ~ pat { inb = 1; depth = 0 }
    inb { print; t = $0; o = gsub(/\{/, "", t); t = $0; c = gsub(/\}/, "", t); depth += o - c; if ((o + c) > 0 && depth <= 0) inb = 0 }' "$@" 2>/dev/null
}

scan_tf() {
  local f d t blk v src p names deep range
  tf_all=()
  while IFS= read -r f; do [ -n "$f" ] && tf_all+=("$f"); done < <(find . -maxdepth 6 \( -name .git -o -name .terraform -o -name node_modules \) -prune \
      -o -type f -name '*.tf' -print 2>/dev/null | sort | head -500)
  # the backend of every stack directory
  s3_aws=0; s3_r2=0; s3_other=0; be_other=""; be_none=0; cloud_block=false; dynamo=false; lock_missing=0; region_missing=0
  for d in ${stack_dirs[@]+"${stack_dirs[@]}"}; do
    ls "$d"/*.tf >/dev/null 2>&1 || continue
    t=$(sed -nE 's/^[[:space:]]*backend[[:space:]]+"([A-Za-z0-9_-]+)".*/\1/p' "$d"/*.tf | head -1)
    if [ -z "$t" ]; then
      if grep -qsE '^[[:space:]]*cloud[[:space:]]*\{' "$d"/*.tf; then cloud_block=true; else be_none=$((be_none + 1)); fi
      continue
    fi
    if [ "$t" != s3 ]; then be_other=$t; continue; fi
    blk=$(blocks '^[[:space:]]*backend[[:space:]]+"s3"' "$d"/*.tf)
    if grep -qE '^[[:space:]]*endpoints?[[:space:]]*=' <<<"$blk"; then
      # an S3-compatible service; the endpoint is never printed (it can carry an account id)
      if grep -qi 'r2\.cloudflarestorage\.com' <<<"$blk"; then s3_r2=$((s3_r2 + 1)); else s3_other=$((s3_other + 1)); fi
    else
      s3_aws=$((s3_aws + 1))
      grep -qE '^[[:space:]]*region[[:space:]]*=' <<<"$blk" || region_missing=$((region_missing + 1))
    fi
    grep -qE '^[[:space:]]*use_lockfile[[:space:]]*=[[:space:]]*true' <<<"$blk" || lock_missing=$((lock_missing + 1))
    if grep -qE '^[[:space:]]*dynamodb_table[[:space:]]*=' <<<"$blk"; then dynamo=true; fi
  done
  profile_found=false; providers=(); mods_local=(); mods_remote=0
  # the OpenTofu version, read as the pipeline reads it (actions/setup/detect-version.sh): the repository root only
  ver=""; ver_src=""; ver_hint="not pinned: add a .opentofu-version file to choose"
  for f in .opentofu-version .tofu-version .terraform-version; do
    [ -f "$f" ] || continue
    v=$(sed -E 's/#.*//; s/^[[:space:]]+//; s/[[:space:]]+$//' "$f" | grep -v '^$' | head -1); v=${v#v}
    if [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then ver=$v; ver_src=$f; break; fi
  done
  if [ -z "$ver" ]; then
    for f in ./*.tf; do
      [ -f "$f" ] || continue
      v=$(sed -nE 's/^[[:space:]]*required_version[[:space:]]*=[[:space:]]*"[[:space:]]*=?[[:space:]]*v?([0-9]+\.[0-9]+\.[0-9]+)[[:space:]]*".*$/\1/p' "$f" | head -1)
      if [ -n "$v" ]; then ver=$v; ver_src="required_version in ${f#./}"; break; fi
    done
  fi
  if [ -z "$ver" ]; then
    range=$(sed -nE 's/^[[:space:]]*required_version[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' ./*.tf 2>/dev/null | head -1)
    [ -n "$range" ] && ver_hint="required_version is a range ($range), not pinned: add a .opentofu-version file to choose"
    deep=$(pinned_below)
    [ -n "$deep" ] && ver_deep=$deep
  fi
  [ "${#tf_all[@]}" -gt 0 ] || return 0
  if grep -qsE '^[[:space:]]*profile[[:space:]]*=' "${tf_all[@]}"; then profile_found=true; fi
  # providers: required_providers sources, provider blocks and the prefixes of resource and data types; utilities need no keys
  src=$(blocks '^[[:space:]]*required_providers' "${tf_all[@]}" | sed -nE 's/.*source[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' | sed 's|.*/||')
  names=$(sed -nE 's/^[[:space:]]*provider[[:space:]]+"([A-Za-z0-9_-]+)".*/\1/p; s/^[[:space:]]*(resource|data)[[:space:]]+"([a-z0-9]+)_[A-Za-z0-9_-]*".*/\2/p' "${tf_all[@]}")
  for p in $(printf '%s\n%s\n' "$src" "$names" | grep -vxE 'terraform|random|null|local|tls|time|archive|external|http|template|cloudinit' | grep -v '^$' | sort -u); do
    providers+=("$p")
  done
  # module relations: local modules of the stacks, and how many come from a registry or git
  for d in ${stack_dirs[@]+"${stack_dirs[@]}"}; do
    for p in $(module_watch "$d"); do case " ${mods_local[*]-} " in *" $p "*) ;; *) mods_local+=("$p");; esac; done
  done
  mods_remote=$(blocks '^[[:space:]]*module[[:space:]]+"' "${tf_all[@]}" | sed -nE 's/^[[:space:]]*source[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' \
                | grep -vE '^\.\.?/' | sort -u | grep -c .)
}

pinned_below() { # an exact required_version below the repository root (bash 3.2 cannot parse this case inside $(...))
  local f
  for f in ${tf_all[@]+"${tf_all[@]}"}; do
    case $f in ./*/*) sed -nE 's/^[[:space:]]*required_version[[:space:]]*=[[:space:]]*"[[:space:]]*=?[[:space:]]*v?([0-9]+\.[0-9]+\.[0-9]+)[[:space:]]*".*$/\1/p' "$f";; esac
  done | head -1
}

# relative module sources of one directory -> repo-relative paths (never outside the repository)
module_watch() {
  local d=$1 f src p out=() seg parts
  for f in "$d"/*.tf; do
    [ -f "$f" ] || continue
    while IFS= read -r src; do
      p="$d/$src"; parts=(); IFS=/ read -ra segs <<<"$p"
      for seg in "${segs[@]}"; do
        case $seg in ''|.) ;; ..) [ "${#parts[@]}" -gt 0 ] || { parts=(); break; }; unset 'parts[${#parts[@]}-1]'; parts=("${parts[@]+"${parts[@]}"}");; *) parts+=("$seg");; esac
      done
      [ "${#parts[@]}" -gt 0 ] || continue
      p=$(IFS=/; echo "${parts[*]}")
      case $p in "$d"|"$d"/*|*[!A-Za-z0-9._/-]*) continue;; esac
      case " ${out[*]-} " in *" $p "*) ;; *) out+=("$p");; esac
    done < <(sed -nE 's/^[[:space:]]*source[[:space:]]*=[[:space:]]*"(\.\.?\/[^"]*)".*/\1/p' "$f")
  done
  echo "${out[*]-}"
}

scan_github_files() {
  local f
  callers=(); pipelines=(); appliers=(); wf_others=0
  for f in .github/workflows/*.yml .github/workflows/*.yaml; do
    [ -f "$f" ] || continue
    if grep -qF "$slug/.github/workflows/" "$f" || grep -qE 'uses:[[:space:]]*["'"'"']?[A-Za-z0-9_.-]+/tfpls/\.github/workflows/' "$f"; then
      callers+=("$f")
    elif grep -qiE 'tofu|terraform' "$f"; then
      pipelines+=("$f")
      if grep -qiE '(tofu|terraform)[^#]*apply' "$f"; then appliers+=("$f"); fi
    else wf_others=$((wf_others + 1)); fi
  done
  # the caller: tofu.yml, or the tfpls caller that is already there under another name (never a second one)
  wf=.github/workflows/tofu.yml
  if [ ! -e "$wf" ] && [ "${#callers[@]}" -gt 0 ]; then wf=${callers[0]}; fi
  codeowners=""
  for f in .github/CODEOWNERS CODEOWNERS docs/CODEOWNERS; do [ -f "$f" ] && { codeowners=$f; break; }; done
  cfg_exists=false; cfg_has_stacks=false
  if [ -e .tfpls.yml ]; then cfg_exists=true; grep -qE '^stacks:' .tfpls.yml && cfg_has_stacks=true; fi
  return 0
}

pretty() {
  case $1 in aws) echo AWS;; cloudflare) echo Cloudflare;; google|google-beta) echo "Google Cloud";; azurerm|azuread) echo Azure;;
    github) echo GitHub;; digitalocean) echo DigitalOcean;; hcloud) echo "Hetzner Cloud";; *) echo "$1";; esac
}
cred_vars() { # the environment variables a provider's credentials usually come from (nothing when unknown)
  case $1 in cloudflare) echo CLOUDFLARE_API_TOKEN;; google|google-beta) echo GOOGLE_CREDENTIALS;;
    azurerm|azuread) echo "ARM_CLIENT_ID ARM_CLIENT_SECRET ARM_TENANT_ID ARM_SUBSCRIPTION_ID";; github) echo GITHUB_TOKEN;;
    digitalocean) echo DIGITALOCEAN_TOKEN;; hcloud) echo HCLOUD_TOKEN;; esac
}

understand() {
  local p
  aws_provider=false; others=(); unknown=()
  for p in ${providers[@]+"${providers[@]}"}; do
    if [ "$p" = aws ]; then aws_provider=true
    elif [ -n "$(cred_vars "$p")" ]; then others+=("$p")
    else unknown+=("$p"); fi
  done
  # AWS credentials (the OIDC role) are needed for an AWS provider, for state in AWS S3, and when nothing says otherwise
  needs_aws=false
  if $aws_provider || [ "$s3_aws" -gt 0 ]; then needs_aws=true
  elif [ "${#providers[@]}" -eq 0 ] && [ $((s3_r2 + s3_other)) -eq 0 ]; then needs_aws=true; fi
  if $needs_aws; then creds_word="the OIDC role is used"; else creds_word="the keys come from TFPLS_ENV_JSON"; fi
}

report() {
  local where lk n f mods wfs="" clouds="" pn
  section "🔎 Looking around"
  if $in_git; then
    if [ -n "$owner" ]; then row Repository "$owner/$repo on GitHub, default branch $branch ($branch_src)"
    else row Repository "git without a GitHub remote (origin), default branch $branch ($branch_src)"; fi
  else row Repository "not a git repository"; fi
  case $layout in
    folders) row Layout "${#found[@]} workspace(s) in workspaces/: ${B}${found[*]}${R}"
             note "${D}the folder names are the tofu workspaces; tofu runs in the repository root, so your root module must load what is in them${R}" ;;
    varfile) row Layout "one root module with a var file per workspace in ${vardir}/: ${B}${varfiles[*]}${R}" ;;
    envs)    row Layout "${#envdirs[@]} separate root module(s) with a backend: ${B}${envdirs[*]}${R}"
             $root_stack && note "the root module has a backend too: it becomes a stack of its own" ;;
    root)    row Layout "one root stack: the root module in ., a single state (the tofu workspace default)" ;;
    *)       row Layout "none found" ;;
  esac
  if [ "${#tf_all[@]}" -eq 0 ]; then row State "-"
  else
    where=""
    [ "$s3_aws" -gt 0 ] && where="AWS S3"
    [ "$s3_r2" -gt 0 ] && where="${where:+$where, }Cloudflare R2 (custom endpoints)"
    [ "$s3_other" -gt 0 ] && where="${where:+$where, }an S3-compatible service (custom endpoints)"
    if [ -n "$where" ]; then
      lk="native locking (use_lockfile)"; [ "$lock_missing" -gt 0 ] && lk="no native locking"
      row State "backend \"s3\" on $where, $lk"
    elif [ -n "$be_other" ]; then row State "backend \"$be_other\""
    else row State "no backend block"; fi
  fi
  for p in ${providers[@]+"${providers[@]}"}; do
    pn=$(pretty "$p"); case ", $clouds, " in *", $pn, "*) ;; *) clouds="${clouds:+$clouds, }$pn";; esac
  done
  if [ -z "$clouds" ]; then row Providers "none found"
  elif $needs_aws; then row Providers "$clouds"
  else row Providers "$clouds (no AWS: no IAM role needed)"; fi
  if [ -n "$ver" ]; then row OpenTofu "$ver (from $ver_src)"; else row OpenTofu "$TOFU_DEFAULT, the default ($ver_hint)"; fi
  mods=""
  [ "${#mods_local[@]}" -gt 0 ] && mods="local: ${mods_local[*]}"
  [ "$mods_remote" -gt 0 ] && mods="${mods:+$mods; }$mods_remote from a registry or git"
  row Modules "${mods:-none}"
  for f in ${callers[@]+"${callers[@]}"}; do wfs="${wfs:+$wfs; }tfpls caller ${f##*/}"; done
  for f in ${pipelines[@]+"${pipelines[@]}"}; do wfs="${wfs:+$wfs; }tofu/terraform pipeline ${f##*/}"; done
  [ "$wf_others" -gt 0 ] && wfs="${wfs:+$wfs; }$wf_others other(s)"
  row Workflows "${wfs:-none yet}"
  if [ -n "$codeowners" ]; then row CODEOWNERS "$codeowners"; else row CODEOWNERS "none (optional: a review rule for .github/ and *.tf)"; fi
  if $cfg_exists; then row Config ".tfpls.yml exists: left as it is"; else row Config ".tfpls.yml: none"; fi

  # what needs attention
  $in_git || warn "this is not a git repository: the workflow assumes the default branch is main"
  $top_ok || warn "this is not the root of the git repository: GitHub reads workflows only from .github/workflows in the root"
  [ "$layout" = none ] && warn "no layout found (no workspaces/<name>/ folders, no var files next to a root module, no directories with a backend block, no .tf files in the root)"
  for n in ${skipped[@]+"${skipped[@]}"}; do warn "workspaces/$n: the name has characters other than letters, digits . _ - and is skipped"; done
  if [ "${#tf_all[@]}" -eq 0 ]; then warn "no .tf files here: run this in the root of your repository"
  else
    [ -n "$be_other" ] && warn "backend \"$be_other\": tfpls supports S3 state with native locking only ($docs/backends.md)"
    $cloud_block && warn "a cloud {} block (HCP Terraform): tfpls supports S3 state only ($docs/backends.md)"
    [ $((s3_aws + s3_r2 + s3_other)) -eq 0 ] && [ -z "$be_other" ] && ! $cloud_block && warn "no backend \"s3\" block: state must be in S3 with native locking ($docs/backends.md)"
    [ "$lock_missing" -gt 0 ] && warn "no use_lockfile = true: S3 native locking is the supported way to lock state ($docs/backends.md)"
    $dynamo && warn "dynamodb_table: DynamoDB lock tables are not supported, native locking (use_lockfile = true) is ($docs/backends.md)"
    [ "$region_missing" -gt 0 ] && warn "no region = ... in the backend block: set it there, CI has no AWS_REGION unless your role or credentials map provides one"
    $profile_found && warn "a profile = \"...\" setting was found: it belongs to your laptop; in CI $creds_word, so remove it from the backend and provider blocks (or set it from a variable)"
    $aws_provider && [ $((s3_r2 + s3_other)) -gt 0 ] && warn "state in an S3-compatible service and an AWS provider: the role's AWS keys win over TFPLS_ENV_JSON, so the backend would get them too; this combination is not verified ($docs/backends.md)"
  fi
  if [ -n "$ver" ]; then
    case $ver in 0.*|1.[0-5].*) warn "OpenTofu $ver: that is a Terraform version (OpenTofu starts at 1.6.0), so the pipeline cannot install it: pin an OpenTofu version in .opentofu-version";; esac
  elif [ -n "${ver_deep:-}" ]; then
    warn "a root module asks for OpenTofu $ver_deep (required_version), but the pipeline reads the version in the repository root only and would use $TOFU_DEFAULT: add a .opentofu-version file with $ver_deep"
  fi
  for f in ${appliers[@]+"${appliers[@]}"}; do warn "$f looks like another tofu/terraform pipeline that applies: two pipelines on one repository will both comment and apply"; done
  for f in ${pipelines[@]+"${pipelines[@]}"}; do
    case " ${appliers[*]-} " in *" $f "*) ;; *) note "$f looks like another tofu/terraform workflow (no apply found): fine next to tfpls if it only checks";; esac
  done
  [ "${#callers[@]}" -gt 1 ] && warn "${#callers[@]} workflows call tfpls ($(join ', ' "${callers[@]}")): each runs the whole pipeline, keep one"
  if $cfg_exists && ! $cfg_has_stacks && [ "$layout" != folders ] && [ "$layout" != none ]; then
    warn ".tfpls.yml has no stacks: block, but this layout needs one (it is never overwritten; the block to add is under Files)"
  fi
  if ! $interactive; then
    if $dry; then note "--dry-run: nothing is asked and nothing is written"
    elif $yes; then note "--yes: no questions, the defaults are taken"
    else note "no terminal: no questions, the defaults are taken"; fi
  fi
}

# ---- the GitHub step (only with a yes, only with an authenticated gh) --------------------------------------------------
names_have() { awk -F'\t' '{print $1}' "$tmpd/out" | grep -qx "$1"; }
online_lookup() {
  local b v
  online=false; gh_repo_id=""; gh_owner_id=""; gh_vis=""; st_role=unknown; st_key=unknown; st_env=unknown
  $interactive && [ -n "$owner" ] && command -v gh >/dev/null 2>&1 || return 0
  section "🌐 GitHub (optional)"
  if ! ask "Look $owner/$repo up on GitHub with gh? Read-only: the IDs for the trust policy, the variable and the secrets" n; then
    note "skipped: nothing goes online"; return 0
  fi
  if ! quietly "asking gh who you are" gh auth status; then warn "gh is not logged in (gh auth login): skipped"; return 0; fi
  if ! quietly "reading $owner/$repo" gh api "repos/$owner/$repo" --jq '[.id, .owner.id, .default_branch, .visibility] | @tsv'; then
    warn "gh could not read $owner/$repo: skipped"; return 0
  fi
  IFS=$'\t' read -r gh_repo_id gh_owner_id b v <"$tmpd/out"
  if ! [[ ${gh_repo_id:-} =~ ^[0-9]+$ && ${gh_owner_id:-} =~ ^[0-9]+$ ]]; then
    gh_repo_id=""; gh_owner_id=""; warn "gh gave an unexpected answer: skipped"; return 0
  fi
  online=true
  case ${v:-} in public|private|internal) gh_vis=$v;; esac
  row Visibility "${gh_vis:-unknown}"
  row IDs "owner $gh_owner_id, repository $gh_repo_id (for the trust policy)"
  $needs_aws && row Trust "sub ${C}\"repo:${owner}/${repo}:*\"${R}  and  ${C}\"repo:${owner}@${gh_owner_id}/${repo}@${gh_repo_id}:*\"${R}"
  if [ -n "${b:-}" ] && [[ ! $b =~ [^A-Za-z0-9._/-] ]] && [ "$b" != "$branch" ]; then
    note "GitHub says the default branch is $b (here: $branch): the push trigger uses $b"; branch=$b; branch_src=GitHub
  fi
  if quietly "reading the variables" gh variable list --repo "$owner/$repo"; then
    if names_have TFPLS_ROLE_ARN; then st_role="set"; else st_role=missing; fi
  fi
  if quietly "reading the secrets" gh secret list --repo "$owner/$repo"; then
    if names_have PLAN_ENCRYPTION_KEY; then st_key="set"; else st_key=missing; fi
    if names_have TFPLS_ENV_JSON; then st_env="set"; else st_env=missing; fi
  fi
  row Variable "TFPLS_ROLE_ARN: $st_role"
  row Secrets "PLAN_ENCRYPTION_KEY: $st_key, TFPLS_ENV_JSON: $st_env"
}
gen_key() { if command -v openssl >/dev/null 2>&1; then openssl rand -base64 32; else head -c 32 /dev/urandom | base64; fi; }
set_key() { gen_key | gh secret set PLAN_ENCRYPTION_KEY --repo "$owner/$repo"; }
online_settings() {
  $online || return 0
  section "🔐 Secrets and variables"
  if [ "$st_key" = missing ] && ask "Generate a random PLAN_ENCRYPTION_KEY and set it as a secret of $owner/$repo? It is never shown" y; then
    if quietly "setting PLAN_ENCRYPTION_KEY" set_key; then ok "PLAN_ENCRYPTION_KEY set (generated here, never shown)"; st_key="set"
    else warn "could not set PLAN_ENCRYPTION_KEY: $(head -1 "$tmpd/err")"; fi
  elif [ "$st_key" = set ]; then ok "PLAN_ENCRYPTION_KEY is set"; fi
  if $needs_aws && [ "$st_role" = missing ]; then
    ask_text "The role for plan and apply, for TFPLS_ROLE_ARN (arn:aws:iam::<account>:role/<name>)" "" valid_arn
    if [ -n "$answer" ]; then
      if quietly "setting TFPLS_ROLE_ARN" gh variable set TFPLS_ROLE_ARN --body "$answer" --repo "$owner/$repo"; then ok "TFPLS_ROLE_ARN set"; st_role="set"
      else warn "could not set TFPLS_ROLE_ARN: $(head -1 "$tmpd/err")"; fi
    fi
  elif $needs_aws && [ "$st_role" = set ]; then ok "TFPLS_ROLE_ARN is set"; fi
  if ! $needs_aws; then
    if [ "$st_env" = set ]; then ok "TFPLS_ENV_JSON is set"; else note "TFPLS_ENV_JSON is not set: it holds your keys, so you set it yourself (the checklist says how)"; fi
  fi
}

# ---- what tfpls will do ------------------------------------------------------------------------------------------------
in_short() {
  local s clouds="" p pn state ci
  section "🧠 In short"
  case $layout in
    folders) s="one root module with ${#found[@]} workspace(s) in workspaces/" ;;
    varfile) s="one root module with a var file per workspace in ${vardir}/" ;;
    envs)    s="${#envdirs[@]} separate root module(s)"; $root_stack && s="$s plus the root module" ;;
    root)    s="one root module with a single state" ;;
    *)       s="no OpenTofu root module that I recognise" ;;
  esac
  for p in ${providers[@]+"${providers[@]}"}; do
    pn=$(pretty "$p"); case ", $clouds, " in *", $pn, "*) ;; *) clouds="${clouds:+$clouds, }$pn";; esac
  done
  [ -n "$clouds" ] && s="$s, managing $clouds"
  if [ "$s3_r2" -gt 0 ]; then state="state in Cloudflare R2"
  elif [ "$s3_other" -gt 0 ]; then state="state in an S3-compatible service"
  elif [ "$s3_aws" -gt 0 ]; then state="state in S3"
  elif [ -n "$be_other" ]; then state="state in a $be_other backend"
  else state="no remote state yet"; fi
  if [ "${#callers[@]}" -gt 0 ]; then ci="tfpls already set up"
  elif [ "${#pipelines[@]}" -gt 0 ]; then ci="another tofu/terraform pipeline"
  else ci="no CI yet"; fi
  s="$s, $state, $ci."
  printf '  %s%s\n' "$(printf '%s' "${s:0:1}" | tr '[:lower:]' '[:upper:]')" "${s:1}"
  if $root_stack; then
    ask_text "Name of the stack (shown in comments, used by /tofu apply <name>)" "$stack_name" safe; stack_name=$answer
  fi
  case $layout in
    folders|varfile) printf '  tfpls plans the workspaces a pull request changes; %s/tofu apply <workspace>%s applies one.\n' "$C" "$R" ;;
    envs) printf '  tfpls plans the root modules a pull request changes; %s/tofu apply <name>%s applies one (for example %s).\n' "$C" "$R" "${envdirs[0]//\//-}" ;;
    root) printf '  tfpls plans it on every pull request as the stack %s%s%s; %s/tofu apply %s%s applies it.\n' "$B" "$stack_name" "$R" "$C" "$stack_name" "$R" ;;
    *) printf '  Describe your layout in .tfpls.yml (stacks:) and run onboarding again.\n' ;;
  esac
}

render_workflow() {
  cat <<YML
name: tofu
on:
  pull_request:
  issue_comment: { types: [created] }
  push: { branches: [${branch}] }
  schedule: [{ cron: "17 5 * * *" }]
  workflow_dispatch:
    inputs:
      task:
        description: What to run
        type: choice
        options: [drift, locks, dashboard, fix]
      workspaces: { description: "fix: workspace names to fix (a drifted workspace); locks: workspace names whose lock is released", type: string }
      step: { description: "fix: plan, apply or fix (plan and apply in one run)", type: choice, options: [fix, plan, apply] }
permissions: { contents: write, pull-requests: write, issues: write, id-token: write, actions: read }
jobs:
  tofu:
    uses: ${slug}/.github/workflows/tofu.yml@${ref}
YML
  case $runs_on in
    ubuntu-latest) ;;
    '['*) printf "    with: { runs_on: '%s' }\n" "$runs_on" ;;
    *) printf '    with: { runs_on: %s }\n' "$runs_on" ;;
  esac
  printf '    secrets: inherit\n'
}

render_config() { # also sets $cfg_active (it describes a layout) and $cfg_what (one line about it)
  local d w ign vfile
  cfg_active=false; cfg_what="comments only"
  echo "# tfpls config: https://github.com/${slug}"
  case $layout in
    varfile)
      vfile="${vardir}/{workspace}.tfvars"; [ "$vardir" = . ] && vfile="{workspace}.tfvars"
      echo "# One root module, one var file per workspace (${vfile})."
      echo "stacks:"
      echo "  - name: app"
      echo "    dir: ."
      printf '    workspaces: [%s]\n' "$(join ', ' "${varfiles[@]}")"
      echo "    var_file: \"${vfile}\""
      echo "    workspace_paths: [\"${vfile}\"]   # a change to one var file plans only that workspace"
      cfg_active=true; cfg_what="one stack app with the workspaces $(join ', ' "${varfiles[@]}")"
      ;;
    envs|root)
      if $root_stack; then
        ign='"**/*.md", "docs/**", ".github/**", "LICENSE*", ".gitignore"'
        for d in ${envdirs[@]+"${envdirs[@]}"}; do ign="$ign, \"$d/**\""; done
        echo "# The root module in the repository root, with a single state: the tofu workspace default."
        echo "stacks:"
        echo "  - name: ${stack_name}"
        echo "    dir: ."
        echo "    workspaces: [default]"
        echo "    ignore: [${ign}]   # changes here plan nothing"
        cfg_what="one stack ${stack_name} in ., workspace default"
      fi
      if [ "$layout" = envs ]; then
        echo "# Separate root modules, one directory each; the tofu workspace is default. watch: modules a stack uses."
        $root_stack || echo "stacks:"
        for d in "${envdirs[@]}"; do
          w=$(module_watch "$d")
          if [ -n "$w" ]; then printf '  - { name: %s, dir: %s, workspaces: [default], watch: [%s] }\n' "${d//\//-}" "$d" "$(echo "$w" | sed 's/ /, /g')"
          else printf '  - { name: %s, dir: %s, workspaces: [default] }\n' "${d//\//-}" "$d"; fi
        done
        if $root_stack; then cfg_what="$cfg_what, plus ${#envdirs[@]} stack(s) on the default workspace"
        else cfg_what="${#envdirs[@]} stack(s) on the default workspace: $(join ', ' "${envdirs[@]}")"; fi
      fi
      cfg_active=true
      ;;
    *)
      echo "# Nothing found to run. Describe your layout, for example:"
      echo "# stacks:"
      echo "#   - { name: dev, dir: envs/dev, workspaces: [default], watch: [modules] }"
      ;;
  esac
  if [ "$layout" = root ]; then
    echo "# Settings (they match a stack or workspace name, * allowed), for example:"
    echo "# overrides:"
    echo "#   ${stack_name}: { drift_fix: false }   # drift is fixed through a pull request only"
  else
    echo "# Examples (settings match a workspace name or a stack name, * allowed):"
    echo "# overrides:"
    echo "#   \"prod*\": { drift_fix: false }   # production drift is fixed through a pull request only"
    echo "#   \"dev*\":  { auto_apply: always }"
  fi
}

show_diff() { # show_diff <file> <new content>: a unified diff, coloured on a terminal, at most 60 lines
  local old=$1 new=$2 n
  if [ -e "$old" ]; then diff -u -L "$old (yours)" -L "$old (recommended)" "$old" "$new" >"$tmpd/diff"
  else diff -u -L /dev/null -L "$old (new)" /dev/null "$new" >"$tmpd/diff"; fi
  n=$(wc -l <"$tmpd/diff" | tr -d ' ')
  head -60 "$tmpd/diff" | while IFS= read -r l; do
    case $l in
      '+++'*|'---'*) printf '    %s%s%s\n' "$B" "$l" "$R" ;;
      +*) printf '    %s%s%s\n' "$G" "$l" "$R" ;;
      -*) printf '    %s%s%s\n' "$RD" "$l" "$R" ;;
      @@*) printf '    %s%s%s\n' "$C" "$l" "$R" ;;
      *) printf '    %s\n' "$l" ;;
    esac
  done
  [ "$n" -le 60 ] || note "... $((n - 60)) more line(s)"
}
fileline() { printf '  %s%s%s %-28s %s%s%s\n' "$1" "$2" "$R" "$3" "$D" "$4" "$R"; }
writable() { # the file (when it exists) or its nearest existing parent directory can be written
  local p=$1
  if [ -e "$p" ]; then [ -w "$p" ] && [ -w "$(dirname "$p")" ]; return; fi
  p=$(dirname "$p"); while [ ! -e "$p" ]; do p=$(dirname "$p"); done
  [ -d "$p" ] && [ -w "$p" ]
}
put() { # put <file> <content>: through a temporary file next to it, so a failed write leaves the old file whole
  mkdir -p "$(dirname "$1")" 2>/dev/null && cp "$2" "$1.tfpls-new" 2>/dev/null && mv -f "$1.tfpls-new" "$1" 2>/dev/null && return 0
  rm -f "$1.tfpls-new" 2>/dev/null; return 1
}

files_step() {
  local f wf_write=false cfg_write=false changed=false
  section "📝 Files"
  render_workflow >"$tmpd/wf"
  if [ ! -e "$wf" ]; then wf_action=new; elif cmp -s "$tmpd/wf" "$wf"; then wf_action=same; else wf_action=differs; fi
  render_config >"$tmpd/cfg"   # (a function with a redirection runs in this shell: it sets cfg_active and cfg_what)
  cfg_action=none
  if $cfg_exists; then cfg_action=keep; elif [ "$layout" != folders ]; then cfg_action=new; fi
  case $wf_action in
    new) fileline "$G" + "$wf" "new: the caller (push to $branch, runner $runs_on)" ;;
    same) fileline "$D" = "$wf" "already up to date" ;;
    differs) fileline "$Y" '~' "$wf" "differs from the recommended caller (the diff is below)" ;;
  esac
  case $cfg_action in
    new) if $cfg_active; then fileline "$G" + .tfpls.yml "new: $cfg_what"; else fileline "$G" + .tfpls.yml "new: comments only, describe your layout in it"; fi ;;
    keep) fileline "$D" = .tfpls.yml "exists: left as it is (never overwritten)" ;;
    none) fileline "$D" ' ' .tfpls.yml "not needed for workspaces/<name>/ folders" ;;
  esac
  if [ "$cfg_action" = keep ] && ! $cfg_has_stacks && [ "$layout" != folders ] && [ "$layout" != none ]; then
    note "add this to your .tfpls.yml (onboarding never changes it):"; sed -n '/^stacks:/,$p' "$tmpd/cfg" | grep -v '^#' | sed 's/^/      /'
  fi
  if $dry; then
    [ "$wf_action" = same ] || show_diff "$wf" "$tmpd/wf"
    [ "$cfg_action" = new ] && show_diff .tfpls.yml "$tmpd/cfg"
    if [ "$wf_action" = same ] && [ "$cfg_action" != new ]; then ok "nothing would change: everything is already up to date"
    else note "dry run: nothing was written"; left "Run onboarding again without --dry-run to write what is shown above"; fi
    return 0
  fi
  if [ "$wf_action" = differs ]; then
    show_diff "$wf" "$tmpd/wf"
    if $force || ask "Replace $wf with the recommended caller?" n; then wf_write=true
    else
      note "kept your $wf (a yes or --force replaces it; .tfpls.yml is never overwritten)"
      left "Your $wf differs from the recommended caller (the diff above): keep it, or run onboarding again with --force"
    fi
  fi
  if [ "$wf_action" = new ] || [ "$cfg_action" = new ]; then
    if ask "Does that look right? Write the new file(s)?" y; then
      [ "$wf_action" = new ] && wf_write=true
      [ "$cfg_action" = new ] && cfg_write=true
    else
      note "nothing new was written. Tell me more with a .tfpls.yml of your own ($docs/getting-started.md#another-layout) or the options (--help), then run me again"
      [ "$wf_write" = true ] || exit 0
    fi
  fi
  targets=(); $wf_write && targets+=("$wf"); $cfg_write && targets+=(.tfpls.yml)
  for f in ${targets[@]+"${targets[@]}"}; do
    writable "$f" || die "cannot write $f: the directory is not writable (check its permissions); nothing was changed"
  done
  if $wf_write; then
    put "$wf" "$tmpd/wf" || die "cannot write $wf"
    changed=true; ok "$wf written ${D}(runs on $runs_on)${R}"
    if [ "$wf_action" = new ]; then done_ "the caller workflow $wf (written)"; else done_ "the caller workflow $wf (replaced)"; fi
  elif [ "$wf_action" = same ]; then done_ "the caller workflow $wf (already up to date)"; fi
  if $cfg_write; then
    put .tfpls.yml "$tmpd/cfg" || die "cannot write .tfpls.yml"
    changed=true
    if $cfg_active; then ok ".tfpls.yml written ${D}(describes your layout)${R}"; done_ ".tfpls.yml: $cfg_what (written)"
    else
      warn ".tfpls.yml has only comments: ${B}describe your layout${R} with a stacks: block, otherwise the pipeline finds nothing to run"
      left "Describe your layout in .tfpls.yml (stacks:): $docs/getting-started.md#another-layout"
    fi
  elif [ "$cfg_action" = keep ]; then done_ ".tfpls.yml (yours, left as it is)"
  elif [ "$cfg_action" = none ]; then done_ "no .tfpls.yml needed for workspaces/<name>/ folders"; fi
  if ! $changed && [ "$wf_action" != differs ]; then ok "✨ nothing to change: everything is already up to date"; fi
  for f in ${appliers[@]+"${appliers[@]}"}; do
    if ask "Retire $f? You delete it in the same pull request (onboarding never deletes a workflow)" n; then
      left "Delete $f in the same pull request: ${C}git rm $f${R}"
    else left "Keep only one pipeline that applies: $f applies too (${C}git rm $f${R} retires it)"; fi
  done
  return 0
}

# ---- what is left ------------------------------------------------------------------------------------------------------
env_json_example() { # the keys TFPLS_ENV_JSON needs: the providers' tokens, and the state keys of an S3-compatible service
  local parts=() p v
  for p in ${others[@]+"${others[@]}"}; do
    for v in $(cred_vars "$p"); do
      case $v in CLOUDFLARE_API_TOKEN) parts+=("\"$v\": \"<API token>\"");; *) parts+=("\"$v\": \"...\"");; esac
    done
  done
  if [ "$s3_r2" -gt 0 ]; then parts+=('"AWS_ACCESS_KEY_ID": "<R2 access key ID>"' '"AWS_SECRET_ACCESS_KEY": "<R2 secret access key>"')
  elif [ "$s3_other" -gt 0 ]; then parts+=('"AWS_ACCESS_KEY_ID": "<access key>"' '"AWS_SECRET_ACCESS_KEY": "<secret key>"'); fi
  printf '{%s}' "$(join ', ' ${parts[@]+"${parts[@]}"})"
}
checklist() {
  local idform sub item more="" p name
  if $needs_aws; then
    if [ "$st_role" = set ]; then done_ "TFPLS_ROLE_ARN is set on GitHub"
    else
      if [ -n "$owner" ]; then
        idform="repo:${owner}@*/${repo}@*:*"; [ -n "$gh_owner_id" ] && idform="repo:${owner}@${gh_owner_id}/${repo}@${gh_repo_id}:*"
        sub="Trust policy condition on token.actions.githubusercontent.com:sub, StringLike, both forms:
  ${C}\"repo:${owner}/${repo}:*\"${R}  and  ${C}\"${idform}\"${R}"
      else sub="${D}Trust policy: sub StringLike \"repo:OWNER/REPO:*\" and \"repo:OWNER@*/REPO@*:*\" (no GitHub remote found to fill it in)${R}"; fi
      [ "${#others[@]}" -gt 0 ] && more="
Also: the secret TFPLS_ENV_JSON with $(env_json_example) (the role covers AWS only)"
      left "One IAM role for plan and apply (OIDC, no stored keys), then: ${C}gh variable set TFPLS_ROLE_ARN --body arn:aws:iam::<account>:role/<role>${R}
$sub
${D}(or one secret with a JSON map of variables: gh secret set TFPLS_ENV_JSON < env.json)  More: $docs/credentials.md${R}$more"
    fi
  else
    if [ "$st_env" = set ]; then done_ "TFPLS_ENV_JSON is set on GitHub"
    else
      item="Credentials: no AWS role is needed, one secret holds a JSON map of environment variables: ${C}gh secret set TFPLS_ENV_JSON < env.json${R}
env.json: ${C}$(env_json_example)${R}"
      [ "$s3_r2" -gt 0 ] && item="$item
The R2 keys are an R2 API token (access key ID and secret) that can write the state bucket, including the .tflock object."
      for p in ${unknown[@]+"${unknown[@]}"}; do item="$item
$p: put its credentials (environment variables) into the same map."; done
      left "$item
${D}Keep env.json out of the repository (delete it after). More: $docs/credentials.md and $docs/backends.md${R}"
    fi
  fi
  if [ "$st_key" = set ]; then done_ "PLAN_ENCRYPTION_KEY is set on GitHub"
  elif [ "$gh_vis" = public ]; then left "Encrypt saved plans (required: the repository is public): ${C}openssl rand -base64 32 | gh secret set PLAN_ENCRYPTION_KEY${R}"
  else left "Encrypt saved plans: ${C}openssl rand -base64 32 | gh secret set PLAN_ENCRYPTION_KEY${R}"; fi
  [ "$nwarn" -gt 0 ] && left "Look at the $nwarn warning(s) above (marked !)"
  name="<workspace>"; [ "$layout" = root ] && name=$stack_name
  item="Commit the files and open ONE pull request: it plans everything and shows each plan as a comment. Merge it (nothing is applied); ${C}/tofu apply $name${R} works on the next pull request."
  case $layout in folders|varfile)
    item="$item
${D}Workspaces that do not exist in your state yet fail the first plan: create each once with \`tofu workspace new <name>\` (tfpls never creates workspaces).${R}";;
  esac
  left "$item"
  left "Approvals follow your repository: the pull request rule of a ruleset on the default branch (1 approval when there is none). You cannot approve your own pull request: add a second account, set the ruleset to 0 approvals, or, as an admin, add ${C}--now${R} to /tofu apply."
  left "Optional: ${C}gh workflow run ${wf##*/} -f task=drift${R} for a first drift check."

  section "✅ Checklist"
  for item in ${done_items[@]+"${done_items[@]}"}; do ok "$item"; done
  local i=0 first rest
  for item in ${left_items[@]+"${left_items[@]}"}; do
    i=$((i + 1)); first=${item%%$'\n'*}; rest=""
    [ "$first" = "$item" ] || rest=${item#*$'\n'}
    printf '  %s☐%s %s%d.%s %s\n' "$Y" "$R" "$B" "$i" "$R" "$first"
    [ -z "$rest" ] || printf '%s\n' "$rest" | sed 's/^/       /'
  done
}

