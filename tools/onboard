#!/usr/bin/env bash
# tfpls onboarding bootstrap: downloads the tfpls binary of a release, checks it against the release's SHA256SUMS,
# caches it and runs `tfpls onboard` with your arguments (the program is internal/onboard; docs/getting-started.md).
#   curl -fsSL https://raw.githubusercontent.com/denzhel/tfpls/v0/tools/onboard | bash -s -- [options] [dir]
# Version: `--ref vX.Y.Z` or TFPLS_REF=vX.Y.Z (a release tag), default the latest release. A cached tag needs no network.
# TFPLS_ONBOARD_BIN=<path to tfpls>: no download, run that binary (offline, tests, `go build ./cmd/tfpls`).
# TFPLS_RELEASE_BASE: the releases URL (tests). A refused checksum never runs anything. Bash 3.2 (macOS) safe.
set -euo pipefail

die() { echo "tfpls: $*" >&2; exit 1; }
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
get() { curl -fsSL --retry 3 --retry-delay 1 -o "$2" "$1" </dev/null; }

download() { # download <url> <tmp>: the archive of this machine and SHA256SUMS
  get "$1/$asset" "$2/$asset" 2>/dev/null && get "$1/SHA256SUMS" "$2/SHA256SUMS" 2>/dev/null
}

fetch() { # prints the path of the verified binary
  local base=${TFPLS_RELEASE_BASE:-https://github.com/denzhel/tfpls/releases} ref=${TFPLS_REF:-} src=env os arch tag="" want
  if [ -z "$ref" ]; then
    while [ $# -gt 1 ]; do if [ "$1" = --ref ]; then ref=$2; src=flag; fi; shift; done
  fi
  case $(uname -s) in Linux) os=linux ;; Darwin) os=darwin ;; *) die "unsupported OS $(uname -s): linux and darwin only" ;; esac
  case $(uname -m) in x86_64|amd64) arch=amd64 ;; arm64|aarch64) arch=arm64 ;; *) die "unsupported architecture $(uname -m): amd64 and arm64 only" ;; esac
  case $ref in v[0-9]*.[0-9]*.[0-9]*) tag=$ref ;; esac   # a release tag; v0 or main are not releases
  asset=tfpls_${os}_${arch}.tar.gz
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/tfpls
  if [ -n "$tag" ] && [ -x "$cache/$tag/tfpls" ]; then echo "$cache/$tag/tfpls"; return 0; fi
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tfpls-boot.XXXXXX"); trap 'rm -rf "$tmp"' EXIT   # fetch runs in a subshell
  if [ -n "$tag" ] && download "$base/download/$tag" "$tmp"; then :
  elif [ -n "$tag" ] && [ "$src" = env ]; then die "cannot download $asset of $tag from $base"
  else
    [ -z "$tag" ] || echo "tfpls: no release $tag (no assets): using the latest release" >&2
    tag=""; download "$base/latest/download" "$tmp" || die "cannot download $asset from $base/latest/download"
  fi
  want=$(awk -v n="$asset" '{ f = $2; sub(/^\*/, "", f) } f == n { print $1 }' "$tmp/SHA256SUMS")
  [ -n "$want" ] || die "$asset is not listed in SHA256SUMS: refusing to run it"
  [ "$(sha "$tmp/$asset")" = "$want" ] || die "checksum mismatch for $asset: refusing to run it"
  if command -v gh >/dev/null 2>&1; then   # informational: the build provenance, never required
    if gh attestation verify "$tmp/$asset" --repo denzhel/tfpls </dev/null >/dev/null 2>&1; then echo "tfpls: build provenance verified (gh attestation)" >&2
    else echo "tfpls: build provenance not checked (gh attestation verify did not confirm; the checksum matched)" >&2; fi
  fi
  mkdir -p "$cache/${tag:-latest}"; tar -xzf "$tmp/$asset" -C "$tmp" tfpls
  mv -f "$tmp/tfpls" "$cache/${tag:-latest}/tfpls"; chmod +x "$cache/${tag:-latest}/tfpls"
  echo "$cache/${tag:-latest}/tfpls"
}

main() {
  local bin=${TFPLS_ONBOARD_BIN:-}
  [ -n "$bin" ] || bin=$(fetch "$@")
  exec "$bin" onboard "$@"   # the program reads its answers from /dev/tty, so stdin may be the pipe this script came from
}

main "$@"
